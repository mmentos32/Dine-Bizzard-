<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Diné Bizaad — Learn Navajo</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet">
<style>
:root {
  --sky:    #1B3A5C;
  --mesa:   #C45E1A;
  --sand:   #F2D9A2;
  --sage:   #4A8C6F;
  --turq:   #2AABB8;
  --cream:  #FDF6E3;
  --dark:   #0E1E30;
  --red:    #C0392B;
  --gold:   #F5A623;
  --white:  #FFFFFF;
  --radius: 18px;
}

- { box-sizing: border-box; margin: 0; padding: 0; }

html {
background: #0E1E30;
min-height: 100%;
}

body {
font-family: ‘Nunito’, sans-serif;
background: linear-gradient(160deg, #0E1E30 0%, #112240 50%, #0A1828 100%);
background-attachment: fixed;
color: var(–cream);
min-height: 100vh;
overflow-x: hidden;
}

/* ─── BG PATTERN ─── */
body::before {
content: ‘’;
position: fixed; inset: 0;
background:
radial-gradient(ellipse at 10% 20%, rgba(196,94,26,.22) 0%, transparent 55%),
radial-gradient(ellipse at 90% 80%, rgba(42,171,184,.16) 0%, transparent 50%);
pointer-events: none; z-index: 0;
}

/* ─── SCREENS ─── */
.screen { display: none; position: relative; z-index: 1; min-height: 100vh; }
.screen.active { display: flex; flex-direction: column; }

/* ════════════════ HOME ════════════════ */
#home {
align-items: center; justify-content: center;
text-align: center; padding: 30px 20px;
gap: 20px;
}

.sun {
width: 90px; height: 90px;
background: radial-gradient(circle, #FFD96B 0%, var(–gold) 50%, #C45E1A 100%);
border-radius: 50%;
box-shadow: 0 0 0 12px rgba(245,166,35,.15), 0 0 60px rgba(245,166,35,.35);
animation: pulse 3s ease-in-out infinite;
margin: 0 auto;
}
@keyframes pulse {
0%,100% { box-shadow: 0 0 0 12px rgba(245,166,35,.15), 0 0 60px rgba(245,166,35,.35); }
50%      { box-shadow: 0 0 0 22px rgba(245,166,35,.1),  0 0 90px rgba(245,166,35,.5); }
}

.home-title {
font-family: ‘Playfair Display’, serif;
font-size: clamp(2rem, 8vw, 3.2rem);
color: var(–sand);
line-height: 1.1;
}
.home-title span { color: var(–mesa); font-style: italic; }
.home-sub { font-size: .95rem; color: rgba(242,217,162,.6); font-weight: 600; letter-spacing: .15em; text-transform: uppercase; }

.stats-row {
display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;
}
.stat-chip {
background: rgba(14, 30, 50, 0.85);
border: 1px solid rgba(242,217,162,.2);
border-radius: 30px;
padding: 8px 18px;
font-size: .85rem; font-weight: 700;
color: var(–sand);
box-shadow: 0 2px 10px rgba(0,0,0,.3);
}
.stat-chip span { color: var(–gold); font-size: 1.1rem; }

.mode-grid {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(200px,1fr));
gap: 14px; width: 100%; max-width: 700px;
}

.mode-card {
background: rgba(14, 30, 50, 0.85);
border: 2px solid rgba(255,255,255,.15);
border-radius: var(–radius);
padding: 24px 20px;
cursor: pointer;
transition: all .25s;
text-align: center;
box-shadow: 0 4px 20px rgba(0,0,0,.3);
}
.mode-card:hover { transform: translateY(-4px); border-color: var(–mesa); background: rgba(196,94,26,.25); }

.mode-icon { font-size: 2.2rem; margin-bottom: 10px; }
.mode-name { font-weight: 800; font-size: 1.05rem; color: var(–sand); margin-bottom: 4px; }
.mode-desc { font-size: .8rem; color: rgba(242,217,162,.5); }
.mode-badge {
display: inline-block; margin-top: 10px;
background: rgba(42,171,184,.2); border: 1px solid var(–turq);
color: var(–turq); font-size: .7rem; padding: 2px 10px; border-radius: 20px;
font-weight: 700;
}

/* ════════════════ QUIZ HEADER ════════════════ */
.quiz-header {
display: flex; align-items: center; gap: 12px;
padding: 16px 20px;
background: rgba(10, 24, 40, 0.97);
border-bottom: 1px solid rgba(42,171,184,.2);
position: sticky; top: 0; z-index: 10;
backdrop-filter: blur(10px);
}

.back-btn {
background: rgba(255,255,255,.08); border: none;
color: var(–sand); width: 38px; height: 38px;
border-radius: 50%; font-size: 1.1rem; cursor: pointer;
display: flex; align-items: center; justify-content: center;
transition: background .2s; flex-shrink: 0;
}
.back-btn:hover { background: rgba(255,255,255,.15); }

.progress-wrap { flex: 1; }
.progress-label { font-size: .75rem; color: rgba(242,217,162,.5); font-weight: 700; margin-bottom: 5px; }
.progress-bar {
height: 8px; background: rgba(255,255,255,.1); border-radius: 10px; overflow: hidden;
}
.progress-fill { height: 100%; border-radius: 10px; background: linear-gradient(90deg, var(–sage), var(–turq)); transition: width .4s ease; }

.score-pill {
background: rgba(245,166,35,.15); border: 1px solid rgba(245,166,35,.3);
color: var(–gold); padding: 6px 14px; border-radius: 20px;
font-weight: 800; font-size: .9rem; white-space: nowrap;
}

/* ════════════════ QUIZ BODY ════════════════ */
.quiz-body {
flex: 1; display: flex; flex-direction: column;
align-items: center; justify-content: center;
padding: 30px 20px; gap: 24px; max-width: 600px; margin: 0 auto; width: 100%;
}

.q-type-label {
font-size: .7rem; letter-spacing: .3em; text-transform: uppercase;
color: var(–turq); font-weight: 700;
}

.q-card {
background: rgba(14, 30, 50, 0.9);
border: 1px solid rgba(42,171,184,.3);
border-radius: 24px;
padding: 32px 28px;
text-align: center; width: 100%;
box-shadow: 0 4px 24px rgba(0,0,0,.4);
}
.q-navajo {
font-family: ‘Playfair Display’, serif;
font-size: clamp(1.8rem, 7vw, 3rem);
color: var(–sand); line-height: 1.2; margin-bottom: 8px;
}
.q-pron { font-size: .9rem; color: var(–mesa); font-style: italic; margin-bottom: 12px; }
.q-hint { font-size: .82rem; color: rgba(242,217,162,.4); }

.speak-q-btn {
background: rgba(42,171,184,.15); border: 1px solid rgba(42,171,184,.35);
color: var(–turq); padding: 8px 20px; border-radius: 20px;
font-family: ‘Nunito’, sans-serif; font-size: .85rem; font-weight: 700;
cursor: pointer; margin-top: 14px; transition: all .2s;
}
.speak-q-btn:hover { background: rgba(42,171,184,.3); }
.speak-q-btn.playing { background: var(–turq); color: white; }

.options-grid {
display: grid; grid-template-columns: 1fr 1fr;
gap: 12px; width: 100%;
}

.opt-btn {
background: rgba(27, 58, 92, 0.85);
border: 2px solid rgba(42,171,184,.35);
border-radius: var(–radius);
padding: 16px 14px;
color: var(–cream); font-family: ‘Nunito’, sans-serif;
font-size: .95rem; font-weight: 700;
cursor: pointer; transition: all .2s; text-align: center;
line-height: 1.3;
box-shadow: 0 2px 12px rgba(0,0,0,.3);
}
.opt-btn:hover:not(:disabled) { border-color: var(–turq); background: rgba(42,171,184,.25); transform: scale(1.02); }
.opt-btn.correct { border-color: var(–sage)!important; background: rgba(74,140,111,.45)!important; color: #7FE0B0; }
.opt-btn.wrong   { border-color: var(–red)!important;  background: rgba(192,57,43,.4)!important;  color: #FF8A80; }
.opt-btn:disabled { cursor: default; }

/* ════════════════ FEEDBACK ════════════════ */
.feedback-bar {
width: 100%; border-radius: var(–radius);
padding: 16px 20px; text-align: center;
font-weight: 800; font-size: 1rem;
transition: all .3s; opacity: 0; transform: translateY(10px);
}
.feedback-bar.show { opacity: 1; transform: translateY(0); }
.feedback-bar.correct-fb { background: rgba(74,140,111,.25); border: 1px solid var(–sage); color: #7FE0B0; }
.feedback-bar.wrong-fb   { background: rgba(192,57,43,.2);   border: 1px solid var(–red);  color: #FF8A80; }

.next-btn {
background: linear-gradient(135deg, var(–mesa), #E07030);
border: none; border-radius: var(–radius);
color: white; padding: 15px 40px;
font-family: ‘Nunito’, sans-serif; font-size: 1rem; font-weight: 800;
cursor: pointer; transition: transform .15s, box-shadow .15s;
box-shadow: 0 4px 20px rgba(196,94,26,.4);
}
.next-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(196,94,26,.5); }

/* ════════════════ FLASHCARD MODE ════════════════ */
.flashcard-wrap {
perspective: 1000px; width: 100%; max-width: 400px; height: 220px;
cursor: pointer; margin: 0 auto;
}
.flashcard {
width: 100%; height: 100%;
position: relative; transform-style: preserve-3d;
transition: transform .5s ease;
border-radius: 24px;
}
.flashcard.flipped { transform: rotateY(180deg); }
.card-face {
position: absolute; inset: 0;
backface-visibility: hidden;
border-radius: 24px;
display: flex; flex-direction: column;
align-items: center; justify-content: center;
padding: 24px;
text-align: center;
}
.card-front {
background: linear-gradient(135deg, rgba(14,30,50,0.97), rgba(196,94,26,.35));
border: 2px solid rgba(196,94,26,.5);
}
.card-back {
background: linear-gradient(135deg, rgba(14,40,30,0.97), rgba(42,171,184,.3));
border: 2px solid rgba(42,171,184,.5);
transform: rotateY(180deg);
}
.card-label { font-size: .7rem; letter-spacing: .3em; text-transform: uppercase; color: rgba(255,255,255,.4); margin-bottom: 10px; }
.card-main {
font-family: ‘Playfair Display’, serif;
font-size: clamp(1.5rem, 6vw, 2.2rem); color: var(–sand);
}
.card-pron { font-size: .85rem; color: var(–mesa); font-style: italic; margin-top: 6px; }
.card-hint { font-size: .78rem; color: rgba(255,255,255,.35); margin-top: 10px; }

.flash-controls {
display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;
}
.flash-btn {
border: 2px solid; border-radius: var(–radius);
padding: 12px 26px; font-family: ‘Nunito’, sans-serif;
font-size: .9rem; font-weight: 800; cursor: pointer; transition: all .2s;
}
.flash-btn.know { border-color: var(–sage); color: var(–sage); background: rgba(74,140,111,.1); }
.flash-btn.know:hover { background: rgba(74,140,111,.3); }
.flash-btn.again { border-color: var(–mesa); color: var(–mesa); background: rgba(196,94,26,.1); }
.flash-btn.again:hover { background: rgba(196,94,26,.3); }
.flash-btn.speak { border-color: var(–turq); color: var(–turq); background: rgba(42,171,184,.1); }
.flash-btn.speak:hover { background: rgba(42,171,184,.25); }

.flash-counter { font-size: .85rem; color: rgba(242,217,162,.4); font-weight: 700; text-align: center; }

/* ════════════════ RESULTS ════════════════ */
#results {
align-items: center; justify-content: center;
padding: 40px 20px; text-align: center; gap: 20px;
}

.trophy { font-size: 4rem; animation: bounce 1s ease; }
@keyframes bounce {
0%,100% { transform: translateY(0); }
40%      { transform: translateY(-18px); }
70%      { transform: translateY(-8px); }
}

.result-title {
font-family: ‘Playfair Display’, serif;
font-size: 2rem; color: var(–sand);
}
.result-score {
font-size: 3.5rem; font-weight: 900; color: var(–gold);
line-height: 1;
}
.result-sub { font-size: .9rem; color: rgba(242,217,162,.5); }

.result-word-list {
width: 100%; max-width: 460px;
display: flex; flex-direction: column; gap: 8px;
max-height: 260px; overflow-y: auto;
}
.result-word {
display: flex; justify-content: space-between; align-items: center;
background: rgba(255,255,255,.05); border-radius: 12px; padding: 10px 16px;
font-size: .9rem;
}
.result-word .rw-nav { color: var(–sand); font-weight: 700; }
.result-word .rw-es  { color: rgba(242,217,162,.6); }
.result-word .rw-icon { font-size: 1.1rem; }

.home-btn {
background: linear-gradient(135deg, var(–sky), #2A5A8C);
border: none; border-radius: var(–radius);
color: white; padding: 14px 36px;
font-family: ‘Nunito’, sans-serif; font-size: 1rem; font-weight: 800;
cursor: pointer; box-shadow: 0 4px 20px rgba(27,58,92,.5);
transition: transform .15s;
}
.home-btn:hover { transform: translateY(-2px); }

/* ════════════════ STREAK TOAST ════════════════ */
.streak-toast {
position: fixed; top: 70px; left: 50%; transform: translateX(-50%) translateY(-80px);
background: linear-gradient(135deg, var(–gold), var(–mesa));
color: white; padding: 10px 24px; border-radius: 30px;
font-weight: 800; font-size: .95rem;
box-shadow: 0 8px 30px rgba(0,0,0,.4);
transition: transform .3s ease; z-index: 200; white-space: nowrap;
}
.streak-toast.show { transform: translateX(-50%) translateY(0); }

/* ════════════════ CATEGORY SELECT ════════════════ */
.cat-select-grid {
display: grid; grid-template-columns: repeat(auto-fill, minmax(140px,1fr));
gap: 12px; width: 100%; max-width: 600px;
}
.cat-sel-card {
background: rgba(14, 30, 50, 0.85); border: 2px solid rgba(255,255,255,.15);
border-radius: var(–radius); padding: 18px 14px;
text-align: center; cursor: pointer; transition: all .2s;
box-shadow: 0 2px 12px rgba(0,0,0,.3);
}
.cat-sel-card:hover, .cat-sel-card.selected {
border-color: var(–mesa); background: rgba(196,94,26,.25);
transform: translateY(-3px);
}
.cat-sel-icon { font-size: 1.8rem; margin-bottom: 6px; }
.cat-sel-name { font-weight: 800; font-size: .9rem; color: var(–sand); }
.cat-sel-count { font-size: .75rem; color: rgba(242,217,162,.4); margin-top: 3px; }

.start-quiz-btn {
background: linear-gradient(135deg, var(–mesa), #E07030);
border: none; border-radius: var(–radius);
color: white; padding: 16px 50px;
font-family: ‘Nunito’, sans-serif; font-size: 1.1rem; font-weight: 800;
cursor: pointer; transition: all .2s; opacity: .5;
box-shadow: 0 4px 20px rgba(196,94,26,.4);
}
.start-quiz-btn.ready { opacity: 1; transform: scale(1); }
.start-quiz-btn.ready:hover { transform: scale(1.03) translateY(-2px); }

#cat-screen {
align-items: center; padding: 30px 20px; gap: 20px;
justify-content: center;
}
#cat-screen h2 { font-family: ‘Playfair Display’, serif; color: var(–sand); font-size: 1.6rem; }
#cat-screen p  { color: rgba(242,217,162,.5); font-size: .9rem; }

/* scrollbar */
::-webkit-scrollbar { width: 5px; }
::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 10px; }
</style>

</head>
<body>

<!-- ──────── HOME ──────── -->

<div id="home" class="screen active">
  <div class="sun"></div>
  <div>
    <div class="home-sub">Diné Bizaad</div>
    <h1 class="home-title">Learn <span>Navajo</span><br>Free Forever</h1>
  </div>
  <div class="stats-row" id="statsRow">
    <div class="stat-chip">🔥 Streak <span id="streakCount">0</span></div>
    <div class="stat-chip">⭐ Points <span id="pointCount">0</span></div>
    <div class="stat-chip">📚 Learned <span id="learnedCount">0</span></div>
  </div>
  <div class="mode-grid">
    <div class="mode-card" onclick="openCatScreen('quiz')">
      <div class="mode-icon">🧠</div>
      <div class="mode-name">Quiz</div>
      <div class="mode-desc">Choose the right meaning. 4 options.</div>
      <span class="mode-badge">+10 pts each</span>
    </div>
    <div class="mode-card" onclick="openCatScreen('flash')">
      <div class="mode-icon">🃏</div>
      <div class="mode-name">Flashcards</div>
      <div class="mode-desc">Flip & study at your pace.</div>
      <span class="mode-badge">All levels</span>
    </div>
    <div class="mode-card" onclick="openCatScreen('match')">
      <div class="mode-icon">🔗</div>
      <div class="mode-name">Match</div>
      <div class="mode-desc">Type the Spanish meaning.</div>
      <span class="mode-badge">+15 pts each</span>
    </div>
    <div class="mode-card" onclick="showScreen('info')">
      <div class="mode-icon">🌄</div>
      <div class="mode-name">Why Navajo?</div>
      <div class="mode-desc">The crisis — and why it matters.</div>
      <span class="mode-badge">Read</span>
    </div>
  </div>
</div>

<!-- ──────── CATEGORY SELECT ──────── -->

<div id="cat-screen" class="screen">
  <button class="back-btn" onclick="showScreen('home')" style="align-self:flex-start">←</button>
  <h2>Choose a Category</h2>
  <p>Select one or more topics to study</p>
  <div class="cat-select-grid" id="catSelectGrid"></div>
  <button class="start-quiz-btn" id="startQuizBtn" onclick="startMode()">Start →</button>
</div>

<!-- ──────── QUIZ ──────── -->

<div id="quiz" class="screen">
  <div class="quiz-header">
    <button class="back-btn" onclick="showScreen('home')">←</button>
    <div class="progress-wrap">
      <div class="progress-label" id="qLabel">Question 1 of 10</div>
      <div class="progress-bar"><div class="progress-fill" id="qProgress" style="width:0%"></div></div>
    </div>
    <div class="score-pill">⭐ <span id="qScore">0</span></div>
  </div>
  <div class="quiz-body">
    <div class="q-type-label" id="qTypeLabel">What does this mean?</div>
    <div class="q-card">
      <div class="q-navajo" id="qNavajo">—</div>
      <div class="q-pron"  id="qPron">—</div>
      <div class="q-hint"  id="qHint"></div>
      <button class="speak-q-btn" id="speakQBtn" onclick="speakCurrent()">🔊 Hear it</button>
    </div>
    <div class="options-grid" id="optionsGrid"></div>
    <div class="feedback-bar" id="feedbackBar"></div>
    <button class="next-btn" id="nextBtn" onclick="nextQuestion()" style="display:none">Next →</button>
  </div>
</div>

<!-- ──────── FLASHCARDS ──────── -->

<div id="flash" class="screen">
  <div class="quiz-header">
    <button class="back-btn" onclick="showScreen('home')">←</button>
    <div class="progress-wrap">
      <div class="progress-label" id="fLabel">Card 1 of 10</div>
      <div class="progress-bar"><div class="progress-fill" id="fProgress" style="width:0%"></div></div>
    </div>
    <div class="score-pill">✅ <span id="fKnown">0</span></div>
  </div>
  <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px 20px;gap:20px;max-width:520px;margin:0 auto;width:100%">
    <div class="q-type-label">Tap card to reveal</div>
    <div class="flashcard-wrap">
      <div class="flashcard" id="flashcard" onclick="flipCard()">
        <div class="card-face card-front">
          <div class="card-label">Navajo</div>
          <div class="card-main" id="fcNavajo">—</div>
          <div class="card-pron" id="fcPron">—</div>
          <div class="card-hint">tap to flip ↓</div>
        </div>
        <div class="card-face card-back">
          <div class="card-label">Spanish</div>
          <div class="card-main" id="fcSpanish" style="font-size:1.6rem">—</div>
          <div class="card-pron" id="fcNote">—</div>
        </div>
      </div>
    </div>
    <div class="flash-counter" id="fCounter">1 / 10</div>
    <div class="flash-controls">
      <button class="flash-btn speak" onclick="speakFlash()">🔊 Hear</button>
      <button class="flash-btn know"  onclick="flashKnow()">✓ Got it</button>
      <button class="flash-btn again" onclick="flashAgain()">↩ Again</button>
    </div>
  </div>
</div>

<!-- ──────── MATCH / TYPE ──────── -->

<div id="match" class="screen">
  <div class="quiz-header">
    <button class="back-btn" onclick="showScreen('home')">←</button>
    <div class="progress-wrap">
      <div class="progress-label" id="mLabel">Word 1 of 8</div>
      <div class="progress-bar"><div class="progress-fill" id="mProgress" style="width:0%"></div></div>
    </div>
    <div class="score-pill">⭐ <span id="mScore">0</span></div>
  </div>
  <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px 20px;gap:20px;max-width:520px;margin:0 auto;width:100%">
    <div class="q-type-label">Type the Spanish meaning</div>
    <div class="q-card" style="margin-bottom:0">
      <div class="q-navajo" id="mNavajo">—</div>
      <div class="q-pron"  id="mPron">—</div>
      <button class="speak-q-btn" onclick="speakMatch()">🔊 Hear it</button>
    </div>
    <input id="matchInput" type="text" placeholder="Escribe en español..."
      style="width:100%;background:rgba(14,30,50,0.9);border:2px solid rgba(42,171,184,.4);border-radius:var(--radius);padding:14px 18px;color:var(--cream);font-family:'Nunito',sans-serif;font-size:1rem;font-weight:700;outline:none;box-shadow:0 2px 12px rgba(0,0,0,.3);"
      onkeydown="if(event.key==='Enter')checkMatch()">
    <button class="next-btn" onclick="checkMatch()">Check ✓</button>
    <div class="feedback-bar" id="mFeedback"></div>
    <button class="next-btn" id="mNextBtn" onclick="nextMatch()" style="display:none">Next →</button>
  </div>
</div>

<!-- ──────── INFO ──────── -->

<div id="info" class="screen" style="padding:30px 20px;max-width:620px;margin:0 auto;gap:20px">
  <button class="back-btn" onclick="showScreen('home')" style="align-self:flex-start">←</button>
  <h2 style="font-family:'Playfair Display',serif;font-size:2rem;color:var(--sand)">Why <em style="color:var(--mesa)">Navajo</em>?</h2>
  <div style="background:rgba(255,255,255,.05);border-left:4px solid var(--mesa);border-radius:12px;padding:20px 22px;line-height:1.8;font-size:.95rem;color:rgba(242,217,162,.85)">
    <strong style="color:var(--sand)">The numbers are alarming.</strong><br><br>
    In 1980, <strong>93%</strong> of Navajo children spoke Diné Bizaad as their first language.
    Today, that number has fallen to around <strong>25%</strong> — and it's still dropping.
    Linguists estimate that by 2030, fewer than 10% may remain fluent.<br><br>
    <strong style="color:var(--sand)">Why does it matter?</strong><br>
    The Navajo language isn't just words — it carries a worldview, ceremonies, medicine, history, and identity
    that cannot be translated into English. When the language disappears, all of that goes with it.<br><br>
    <strong style="color:var(--sand)">What happened?</strong><br>
    For decades, Navajo children were sent to boarding schools where speaking their language was punished.
    That trauma broke the chain of transmission across generations.<br><br>
    <strong style="color:var(--sand)">This app is free.</strong><br>
    Every word you learn is a small act of cultural preservation.
    Share it with anyone — Navajo youth, teachers, families, and allies — for free, always.
  </div>
  <div style="background:rgba(42,171,184,.1);border:1px solid rgba(42,171,184,.3);border-radius:12px;padding:16px 20px;font-size:.9rem;color:rgba(242,217,162,.8)">
    🌐 On <strong style="color:var(--turq)">December 24, 2024</strong>, President Buu Nygren signed a law making
    Navajo the <strong>official language of the Navajo Nation</strong> — a milestone and a call to action.
  </div>
  <button class="home-btn" onclick="showScreen('home')">← Back to Home</button>
</div>

<!-- ──────── RESULTS ──────── -->

<div id="results" class="screen">
  <div class="trophy" id="trophyEmoji">🏆</div>
  <div class="result-title" id="resultTitle">Round Complete!</div>
  <div class="result-score" id="resultScore">0</div>
  <div class="result-sub" id="resultSub">points earned</div>
  <div class="result-word-list" id="resultWordList"></div>
  <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center">
    <button class="next-btn" onclick="replayMode()">Play Again 🔄</button>
    <button class="home-btn"  onclick="showScreen('home')">Home 🏠</button>
  </div>
</div>

<!-- STREAK TOAST -->

<div class="streak-toast" id="streakToast">🔥 3 in a row!</div>

<script>
// ════════ DATA ════════
const allWords = [
  { nav:"Yáʼátʼééh",   pron:"yá-at-éeh",       es:"Hola / Buenos días",       note:"Saludo universal",           cat:"esencial",   audio:"yá-at-éeh" },
  { nav:"Hágoóneeʼ",   pron:"há-goo-nee",       es:"Adiós",                    note:"Despedida",                  cat:"esencial",   audio:"há-goo-nee" },
  { nav:"Aoo'",         pron:"a-oo",              es:"Sí",                       note:"Afirmación",                 cat:"esencial",   audio:"a-oo" },
  { nav:"Dooda",        pron:"doo-da",            es:"No",                       note:"Negación",                   cat:"esencial" },
  { nav:"Tó",           pron:"tó",                es:"Agua",                     note:"Elemento sagrado",           cat:"esencial" },
  { nav:"Hózhó",        pron:"hó-zhó",            es:"Armonía / Belleza",        note:"Concepto filosófico central",cat:"esencial",   audio:"hó-yó" },
  { nav:"Nizhóní",      pron:"ni-zhó-ni",         es:"Hermoso / Bonito",         note:"",                           cat:"esencial",   audio:"ni-yó-ni" },
  { nav:"Iiná",         pron:"ii-ná",             es:"Vida",                     note:"Concepto fundamental",       cat:"esencial" },

  { nav:"Shimá",        pron:"shi-má",            es:"Mi mamá",                  note:"shi = mi",                   cat:"familia" },
  { nav:"Shizhéʼé",    pron:"shi-zhé-e",         es:"Mi papá",                  note:"",                           cat:"familia",    audio:"chi-yé-e" },
  { nav:"Shideezhí",   pron:"shi-dee-zhí",       es:"Mi hermana menor",         note:"",                           cat:"familia",    audio:"chi-dee-yí" },
  { nav:"Shinaaí",      pron:"shi-naa-í",         es:"Mi hermano mayor",         note:"",                           cat:"familia" },
  { nav:"Shimásání",   pron:"shi-má-sá-ni",      es:"Mi abuela materna",        note:"",                           cat:"familia" },
  { nav:"Ashkii",       pron:"ash-kii",           es:"Niño (varón)",             note:"",                           cat:"familia" },
  { nav:"Atʼééd",      pron:"a-téd",             es:"Niña",                     note:"",                           cat:"familia" },
  { nav:"Sitsóí",      pron:"si-tsói",           es:"Mi nieto / nieta",         note:"Sin distinción de género",   cat:"familia" },

  { nav:"Nahasdzáán",  pron:"na-has-dzáan",      es:"La Tierra / El suelo",     note:"Madre Tierra",               cat:"naturaleza" },
  { nav:"Jóhonaaʼéí", pron:"jó-ho-naa-éi",      es:"El Sol",                   note:"Ser sagrado",                cat:"naturaleza" },
  { nav:"Ooljééʼ",    pron:"ool-jée",            es:"La Luna",                  note:"Ser femenino",               cat:"naturaleza" },
  { nav:"Zǫʼ",         pron:"zó",                es:"Estrella",                 note:"",                           cat:"naturaleza" },
  { nav:"Tsin",         pron:"tsin",              es:"Árbol / Madera",           note:"",                           cat:"naturaleza" },
  { nav:"Ko'",          pron:"kó",                es:"Fuego",                    note:"Centro del hogar",           cat:"naturaleza" },
  { nav:"Níltsą",      pron:"níl-tsa",           es:"Lluvia",                   note:"",                           cat:"naturaleza" },
  { nav:"Dził",         pron:"dzil",              es:"Montaña",                  note:"Las 4 montañas sagradas",    cat:"naturaleza" },

  { nav:"Łizhin",       pron:"li-iz-hin",         es:"Negro",                    note:"La ł es l soplada",          cat:"colores",    audio:"li-is-hin" },
  { nav:"Łigai",        pron:"li-gai",            es:"Blanco",                   note:"",                           cat:"colores",    audio:"li-gai" },
  { nav:"Łichíʼí",     pron:"li-chí-i",          es:"Rojo",                     note:"",                           cat:"colores",    audio:"li-chí-i" },
  { nav:"Dootłʼizh",   pron:"doo-tl-izh",        es:"Azul / Turquesa",          note:"Azul, verde y turquesa = 1 palabra", cat:"colores", audio:"doo-tl-is" },
  { nav:"Łitso",        pron:"li-it-so",          es:"Amarillo",                 note:"",                           cat:"colores",    audio:"li-it-so" },
  { nav:"Libá",         pron:"li-bá",             es:"Gris",                     note:"Como la ceniza",             cat:"colores" },

  { nav:"Łį́į́ʼ",      pron:"lii",               es:"Caballo",                  note:"Transformó la cultura navaja", cat:"animales", audio:"lii" },
  { nav:"Dibé",         pron:"di-bé",             es:"Oveja",                    note:"Animal central en la tradición", cat:"animales" },
  { nav:"Mąʼii",        pron:"má-i",              es:"Coyote",                   note:"Ser mítico embaucador",      cat:"animales" },
  { nav:"Shash",        pron:"chach",             es:"Oso",                      note:"Animal sagrado",             cat:"animales" },
  { nav:"Atʼą́ą́ʼ",    pron:"a-táa",             es:"Águila",                   note:"Sus plumas son sagradas",    cat:"animales" },
  { nav:"Mósí",         pron:"mó-si",             es:"Gato",                     note:"",                           cat:"animales" },
  { nav:"Łééchąąʼí",   pron:"lé-chaa-i",         es:"Perro",                    note:"",                           cat:"animales",   audio:"lé-chaa-i" },
  { nav:"Béégashii",   pron:"béé-ga-chii",       es:"Vaca",                     note:"",                           cat:"animales" },
];

const categories = [
  { id:"esencial",   icon:"⭐", name:"Esencial",   label:"Essential" },
  { id:"familia",    icon:"👨‍👩‍👧", name:"Familia",    label:"Family" },
  { id:"naturaleza", icon:"🌿", name:"Naturaleza", label:"Nature" },
  { id:"colores",    icon:"🎨", name:"Colores",    label:"Colors" },
  { id:"animales",   icon:"🐾", name:"Animales",   label:"Animals" },
];

// ════════ STATE ════════
let streak = 0, points = 0, learnedSet = new Set();
let currentMode = '', selectedCats = [], currentDeck = [];
let qIndex = 0, qScore = 0, qMissed = [];
let fIndex = 0, fKnownCount = 0, fDeck = [];
let mIndex = 0, mScore = 0;
let consecutiveCorrect = 0;

function saveState() {
  try { localStorage.setItem('dine_state', JSON.stringify({ streak, points, learned: [...learnedSet] })); } catch(e) {}
}
function loadState() {
  try {
    const s = JSON.parse(localStorage.getItem('dine_state') || '{}');
    streak = s.streak || 0;
    points = s.points || 0;
    learnedSet = new Set(s.learned || []);
    updateHomeStats();
  } catch(e) {}
}
function updateHomeStats() {
  document.getElementById('streakCount').textContent = streak;
  document.getElementById('pointCount').textContent = points;
  document.getElementById('learnedCount').textContent = learnedSet.size;
}

// ════════ NAVIGATION ════════
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  if (id === 'home') updateHomeStats();
}

function openCatScreen(mode) {
  currentMode = mode;
  selectedCats = [];
  renderCatSelect();
  showScreen('cat-screen');
}

function renderCatSelect() {
  const grid = document.getElementById('catSelectGrid');
  grid.innerHTML = categories.map(c => {
    const count = allWords.filter(w => w.cat === c.id).length;
    return `<div class="cat-sel-card" id="cat_${c.id}" onclick="toggleCat('${c.id}')">
      <div class="cat-sel-icon">${c.icon}</div>
      <div class="cat-sel-name">${c.name}</div>
      <div class="cat-sel-count">${count} words</div>
    </div>`;
  }).join('');
  updateStartBtn();
}

function toggleCat(id) {
  const idx = selectedCats.indexOf(id);
  if (idx >= 0) selectedCats.splice(idx, 1);
  else selectedCats.push(id);
  document.querySelectorAll('.cat-sel-card').forEach(el => el.classList.remove('selected'));
  selectedCats.forEach(id => { const el = document.getElementById('cat_' + id); if (el) el.classList.add('selected'); });
  updateStartBtn();
}

function updateStartBtn() {
  const btn = document.getElementById('startQuizBtn');
  btn.classList.toggle('ready', selectedCats.length > 0);
}

function startMode() {
  if (!selectedCats.length) return;
  let deck = allWords.filter(w => selectedCats.includes(w.cat));
  deck = shuffle(deck);
  currentDeck = deck.slice(0, currentMode === 'match' ? 8 : 10);
  if (currentMode === 'quiz')  startQuiz();
  else if (currentMode === 'flash') startFlash();
  else if (currentMode === 'match') startMatch();
}

// ════════ QUIZ ════════
function startQuiz() {
  qIndex = 0; qScore = 0; qMissed = [];
  consecutiveCorrect = 0;
  document.getElementById('qScore').textContent = 0;
  showScreen('quiz');
  renderQuestion();
}

function renderQuestion() {
  const w = currentDeck[qIndex];
  const total = currentDeck.length;
  document.getElementById('qLabel').textContent = `Question ${qIndex+1} of ${total}`;
  document.getElementById('qProgress').style.width = `${(qIndex/total)*100}%`;
  document.getElementById('qNavajo').textContent = w.nav;
  document.getElementById('qPron').textContent   = w.pron;
  document.getElementById('qHint').textContent   = w.note || '';
  document.getElementById('qTypeLabel').textContent = 'What does this mean in Spanish?';
  document.getElementById('feedbackBar').className = 'feedback-bar';
  document.getElementById('feedbackBar').textContent = '';
  document.getElementById('nextBtn').style.display = 'none';

  // build 4 options
  let options = [w];
  const pool = allWords.filter(x => x.nav !== w.nav);
  const wrong = shuffle(pool).slice(0, 3);
  options = shuffle([...options, ...wrong]);

  const grid = document.getElementById('optionsGrid');
  grid.innerHTML = options.map(o =>
    `<button class="opt-btn" onclick="checkAnswer('${o.nav.replace(/'/g,"\\'")}', '${w.nav.replace(/'/g,"\\'")}', this)">${o.es}</button>`
  ).join('');
}

function checkAnswer(chosen, correct, btn) {
  document.querySelectorAll('.opt-btn').forEach(b => b.disabled = true);
  const w = currentDeck[qIndex];
  const fb = document.getElementById('feedbackBar');

  if (chosen === correct) {
    btn.classList.add('correct');
    consecutiveCorrect++;
    qScore += 10;
    points += 10;
    learnedSet.add(w.nav);
    document.getElementById('qScore').textContent = qScore;
    fb.textContent = `✓ Correct! "${w.nav}" = ${w.es}`;
    fb.className = 'feedback-bar correct-fb show';
    if (consecutiveCorrect >= 3) showStreak(consecutiveCorrect);
  } else {
    btn.classList.add('wrong');
    consecutiveCorrect = 0;
    qMissed.push(w);
    // highlight correct
    document.querySelectorAll('.opt-btn').forEach(b => {
      if (b.textContent === w.es) b.classList.add('correct');
    });
    fb.textContent = `✗ It was: ${w.es}`;
    fb.className = 'feedback-bar wrong-fb show';
  }
  saveState();
  document.getElementById('nextBtn').style.display = 'block';
}

function nextQuestion() {
  qIndex++;
  if (qIndex >= currentDeck.length) {
    showResults('quiz', qScore, qMissed);
  } else {
    renderQuestion();
  }
}

// ════════ FLASHCARDS ════════
function startFlash() {
  fIndex = 0; fKnownCount = 0;
  fDeck = [...currentDeck];
  document.getElementById('fKnown').textContent = 0;
  showScreen('flash');
  document.getElementById('flashcard').classList.remove('flipped');
  renderFlashCard();
}

function renderFlashCard() {
  const w = fDeck[fIndex];
  const total = fDeck.length;
  document.getElementById('fLabel').textContent    = `Card ${fIndex+1} of ${total}`;
  document.getElementById('fProgress').style.width = `${(fIndex/total)*100}%`;
  document.getElementById('fCounter').textContent  = `${fIndex+1} / ${total}`;
  document.getElementById('fcNavajo').textContent  = w.nav;
  document.getElementById('fcPron').textContent    = w.pron;
  document.getElementById('fcSpanish').textContent = w.es;
  document.getElementById('fcNote').textContent    = w.note || '';
  document.getElementById('flashcard').classList.remove('flipped');
}

function flipCard() {
  document.getElementById('flashcard').classList.toggle('flipped');
}

function flashKnow() {
  fKnownCount++;
  learnedSet.add(fDeck[fIndex].nav);
  points += 5;
  document.getElementById('fKnown').textContent = fKnownCount;
  saveState();
  advanceFlash();
}

function flashAgain() {
  // push to end
  fDeck.push(fDeck[fIndex]);
  advanceFlash();
}

function advanceFlash() {
  fIndex++;
  if (fIndex >= fDeck.length) {
    showResults('flash', fKnownCount * 5, []);
  } else {
    renderFlashCard();
  }
}

function speakFlash() {
  const w = fDeck[fIndex];
  speakText(w.audio || w.pron);
}

// ════════ MATCH / TYPE ════════
function startMatch() {
  mIndex = 0; mScore = 0;
  document.getElementById('mScore').textContent = 0;
  showScreen('match');
  document.getElementById('mFeedback').className = 'feedback-bar';
  document.getElementById('mNextBtn').style.display = 'none';
  renderMatch();
}

function renderMatch() {
  const w = currentDeck[mIndex];
  const total = currentDeck.length;
  document.getElementById('mLabel').textContent    = `Word ${mIndex+1} of ${total}`;
  document.getElementById('mProgress').style.width = `${(mIndex/total)*100}%`;
  document.getElementById('mNavajo').textContent   = w.nav;
  document.getElementById('mPron').textContent     = w.pron;
  const input = document.getElementById('matchInput');
  input.value = '';
  input.disabled = false;
  input.focus();
  document.getElementById('mFeedback').className = 'feedback-bar';
  document.getElementById('mNextBtn').style.display = 'none';
  document.querySelector('#match .next-btn').style.display = 'block';
}

function checkMatch() {
  const w = currentDeck[mIndex];
  const input = document.getElementById('matchInput');
  const typed = input.value.trim().toLowerCase();
  const correct = w.es.toLowerCase();
  const fb = document.getElementById('mFeedback');
  input.disabled = true;
  document.querySelector('#match .next-btn').style.display = 'none';

  // Accept partial match (any keyword)
  const keywords = correct.split(/[\/,\s]+/).filter(k => k.length > 2);
  const isOk = keywords.some(k => typed.includes(k)) || typed === correct;

  if (isOk) {
    mScore += 15; points += 15;
    learnedSet.add(w.nav);
    document.getElementById('mScore').textContent = mScore;
    fb.textContent = `✓ ¡Correcto! ${w.es}`;
    fb.className = 'feedback-bar correct-fb show';
  } else {
    fb.textContent = `✗ Era: ${w.es}`;
    fb.className = 'feedback-bar wrong-fb show';
  }
  saveState();
  document.getElementById('mNextBtn').style.display = 'block';
}

function nextMatch() {
  mIndex++;
  if (mIndex >= currentDeck.length) showResults('match', mScore, []);
  else renderMatch();
}

function speakMatch() {
  const w = currentDeck[mIndex];
  speakText(w.audio || w.pron);
}

// ════════ RESULTS ════════
function showResults(mode, scoreEarned, missed) {
  const pct = mode === 'flash' ? Math.round((fKnownCount / currentDeck.length) * 100)
            : mode === 'quiz'  ? Math.round(((currentDeck.length - missed.length) / currentDeck.length) * 100)
            : Math.round((mScore / (currentDeck.length * 15)) * 100);

  const emojis  = pct >= 90 ? '🏆' : pct >= 70 ? '🌟' : pct >= 50 ? '👍' : '💪';
  const titles  = pct >= 90 ? 'Nizhóní! (Beautiful!)' : pct >= 70 ? 'Hózhó! (Harmony!)' : pct >= 50 ? 'Great effort!' : 'Keep going!';

  streak++;
  document.getElementById('trophyEmoji').textContent  = emojis;
  document.getElementById('resultTitle').textContent  = titles;
  document.getElementById('resultScore').textContent  = '+' + scoreEarned;
  document.getElementById('resultSub').textContent    = 'points earned this round';

  const list = document.getElementById('resultWordList');
  list.innerHTML = currentDeck.map(w => {
    const wasWrong = missed.some(m => m.nav === w.nav);
    return `<div class="result-word">
      <span class="rw-nav">${w.nav}</span>
      <span class="rw-es">${w.es}</span>
      <span class="rw-icon">${wasWrong ? '❌' : '✅'}</span>
    </div>`;
  }).join('');

  saveState();
  showScreen('results');
}

function replayMode() {
  startMode();
}

// ════════ SPEAK ════════
function speakText(pron) {
  if (!window.speechSynthesis) return;
  window.speechSynthesis.cancel();
  const clean = pron.toLowerCase()
    .replace(/-/g, ' ').replace(/ł([aeiouáéíóú])/g, 'l$1').replace(/ł/g, '')
    .replace(/[ʼ'ʻ]/g, '').replace(/tł/g, 'tl').replace(/zh/g, 'y')
    .replace(/gh/g, 'j').replace(/hw/g, 'ju').replace(/\bsh/g, 'ch').replace(/sh/g, 'ss')
    .replace(/[^a-záéíóúüñ\s]/gi, '').replace(/\s+/g, ' ').trim();
  const u = new SpeechSynthesisUtterance(clean);
  u.lang = 'es-MX'; u.rate = 0.6; u.pitch = 1.05;
  window.speechSynthesis.speak(u);
}

function speakCurrent() {
  const w = currentDeck[qIndex];
  const btn = document.getElementById('speakQBtn');
  btn.classList.add('playing');
  btn.textContent = '🔊 ...';
  speakText(w.audio || w.pron);
  setTimeout(() => { btn.classList.remove('playing'); btn.textContent = '🔊 Hear it'; }, 2000);
}

// ════════ STREAK TOAST ════════
function showStreak(n) {
  const t = document.getElementById('streakToast');
  t.textContent = `🔥 ${n} in a row! +bonus`;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2200);
}

// ════════ UTILS ════════
function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i+1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

// ════════ INIT ════════
loadState();
</script>

